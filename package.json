{
  "name": "edu-tools",
  "version": "1.0.0",
  "private": true,
  "description": "Инструменты для работы с образовательными системами",
  "main": "index.js",
  "type": "module",
  "homepage": "https://edu-tools.fiit-urfu-cloud.ru",
  "privacyPolicy": "https://edu-tools.fiit-urfu-cloud.ru/privacy",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "npx nodemon",
    "build": "rimraf ./build && npx tsc",
    "lint": "npx eslint ./src",
    "format": "npx eslint ./src --fix",
    "docs:check": "node ./scripts/check-memory-bank.mjs",
    "cli": "npm run -s build && node --no-warnings --loader ./loader.js build/cli/main",
    "legacy-scripts": "npm run build && node --loader ./loader.js build/legacyScripts",
    "bot-dev": "npx nodemon --exec npx ts-node ./src/bot.ts",
    "bot-start": "npm run build && node --loader ./loader.js build/bot-start",
    "bot-register": "node --loader ./loader.js build/bot-register",
    "web-start": "react-scripts start",
    "web-build": "rimraf ./build && react-scripts build",
    "web-test": "react-scripts test",
    "web-eject": "react-scripts eject",
    "prepare": "husky"
  },
  "keywords": [
    "education",
    "tools"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/dotenv-safe": "^8.1.6",
    "@types/node": "^18.11.10",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "ajv": "^8.17.1",
    "ajv-keywords": "^5.1.0",
    "eslint": "^8.29.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "nodemon": "^3.1.9",
    "prettier": "^2.8.0",
    "rimraf": "^3.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@emotion/react": "latest",
    "@emotion/styled": "latest",
    "@mui/icons-material": "^7.0.2",
    "@mui/material": "next",
    "@notionhq/client": "^2.2.12",
    "@react-oauth/google": "^0.12.1",
    "@telegraf/entity": "^0.5.0",
    "@tryfabric/martian": "^1.2.0",
    "commander": "^14.0.3",
    "dotenv": "^16.4.5",
    "google-auth-library": "^9.7.0",
    "googleapis": "^134.0.0",
    "hast-util-from-html": "^2.0.1",
    "hast-util-to-mdast": "^10.0.0",
    "mdast-util-to-markdown": "^2.1.0",
    "node-fetch": "^3.3.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.5.0",
    "react-scripts": "^5.0.1",
    "telegraf": "^4.16.0",
    "zustand": "^5.0.3"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
