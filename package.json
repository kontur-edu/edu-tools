{
  "name": "edu-tools",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "husky": {
    "hooks": {
      "pre-commit": "npm run lint"
    }
  },
  "scripts": {
    "dev": "npx nodemon",
    "build": "rimraf ./build && npx tsc",
    "start": "npm run build && node build/main",
    "bot-dev": "npx nodemon --exec npx ts-node ./src/bot.ts",
    "bot-start": "npm run build && node build/bot-start",
    "bot-register": "node build/bot-register",
    "lint": "npx eslint ./src",
    "format": "npx eslint ./src --fix"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^18.11.10",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "eslint": "^8.29.0",
    "husky": "^8.0.2",
    "nodemon": "^3.1.9",
    "prettier": "^2.8.0",
    "rimraf": "^3.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@notionhq/client": "^2.2.12",
    "@telegraf/entity": "^0.5.0",
    "@tryfabric/martian": "^1.2.0",
    "@types/dotenv-safe": "^8.1.6",
    "dotenv": "^16.4.5",
    "google-auth-library": "^9.7.0",
    "googleapis": "^134.0.0",
    "hast-util-from-html": "^2.0.1",
    "hast-util-to-mdast": "^10.0.0",
    "mdast-util-to-markdown": "^2.1.0",
    "node-fetch": "^3.3.2",
    "telegraf": "^4.16.0"
  }
}
